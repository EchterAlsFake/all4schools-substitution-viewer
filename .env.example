# Bootstrap token; a valid data/api-token takes precedence after a refresh.
VPLAN_API_TOKEN=replace-with-local-token
VPLAN_DATA_DIR=data
VPLAN_API_URL=https://plan-api.example.invalid/endpoint
VPLAN_API_REFRESH_URL=https://refresh-api.example.invalid/endpoint
VPLAN_API_AUTH_URL=https://auth-api.example.invalid/endpoint
USERNAME=replace-with-school-account-name
PASSWORD=replace-with-school-account-password
VPLAN_SCHOOL_ID=replace-with-school-id
VPLAN_GATE_ANSWERS=replace-with-accepted-answers
VPLAN_PUBLIC_HOST=vplan.echteralsfake.me
VPLAN_TRUST_CLOUDFLARE_IP=true
VPLAN_SECURE_COOKIE=true
VPLAN_UPGRADE_INSECURE_REQUESTS=true
VPLAN_SYNC_ENABLED=true
VPLAN_SYNC_INTERVAL_SECONDS=300
